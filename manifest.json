{
  "manifest_version": 3,
  "name": "Negatif İçerik Filtresi",
  "version": "0.1.0",
  "description": "Sosyal medya akışındaki olumsuz/negatif içerikleri tespit edip gizler.",
  "key": "",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://user-lenovo-g500.tailb6efdb.ts.net/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Negatif İçerik Filtresi"
  }
}